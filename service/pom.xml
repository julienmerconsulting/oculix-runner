<?xml version="1.0" encoding="UTF-8"?>
<!--
  oculix-runner-service : HTTP API + SQLite on top of a warm OculiX JVM.

  The OculiX IDE jar is NOT bundled: it is the brick everything sits on, and it
  is already installed in the runner image at /opt/oculix/oculix.jar. It is
  declared with system scope so the build compiles against it wherever it is:

    mvn -Doculix.jar=/path/to/oculixide-x.y.z-linux.jar package

  At runtime the two jars simply share a classpath:

    java -cp oculix-runner-service.jar:/opt/oculix/oculix.jar org.oculix.runner.Main
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.oculix</groupId>
  <artifactId>oculix-runner-service</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <oculix.jar>/opt/oculix/oculix.jar</oculix.jar>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.47.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>
    <!-- Compile-time only: the OculiX IDE jar (Runner, Commons, Debug, Sikulix). -->
    <dependency>
      <groupId>io.github.oculix-org</groupId>
      <artifactId>oculixide</artifactId>
      <version>4.0.0</version>
      <scope>system</scope>
      <systemPath>${oculix.jar}</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>oculix-runner-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <excludes>
                  <exclude>io.github.oculix-org:oculixide</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.oculix.runner.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
